# --- Discord ---
# Create app at https://discord.com/developers/applications
# Bot tab -> Token
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# Right-click your server in Discord (with Developer Mode on) -> Copy Server ID
DISCORD_GUILD_ID=
# Right-click the dedicated coworking VC -> Copy Channel ID
# Bot auto-joins this VC when any roster member speaks
DISCORD_COWORKING_VC_ID=

# --- Anthropic API (cascade extraction) ---
ANTHROPIC_API_KEY=

# --- GitHub PATs (SCOPE NARROWLY) ---
# Fine-grained PAT, contents:write ONLY on songchaindao-dot/cowork-zaodevz/data/actions.json
COWORK_GITHUB_TOKEN=
# Fine-grained PAT, contents:write ONLY on bettercallzaal/zaoscribe/data/transcripts/*
ZAOSCRIBE_GITHUB_TOKEN=

# --- OpenAI Whisper API fallback (optional, used only if local Whisper.cpp errors) ---
OPENAI_API_KEY=

# --- Paths (override defaults) ---
# Default: /tmp/zaoscribe-audio/
# AUDIO_DIR=/tmp/zaoscribe-audio
# Default: /opt/whisper.cpp/models/ggml-medium.bin
# WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-medium.bin
# Default: /opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli

# --- Behaviour tuning ---
# Confidence threshold above which items auto-write (0..1)
# Default: 0.8
# CONFIDENCE_AUTO_WRITE=0.8
# Hours to keep raw audio before cleanup cron
# Default: 24
# AUDIO_RETENTION_HOURS=24

# --- Optional: log level ---
# debug | info | warn | error
LOG_LEVEL=info
