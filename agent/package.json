{
  "name": "zaoscribe-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZAOscribe - Discord audio capture bot. Per-speaker streams -> Whisper.cpp -> Anthropic cascade -> cowork-zaodevz action tracker.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
